{
  "name": "chordi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/browser.mjs",
    "format": "prettier --write src tests scripts docs *.md index.html package.json pnpm-workspace.yaml .github",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "format:check": "prettier --check src tests scripts docs *.md index.html package.json pnpm-workspace.yaml .github"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "jspdf": "^4.2.1",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^6.3.289",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.5.1"
}
